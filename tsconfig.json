{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "lib": [
            "ES2023",
            "ESNext.Disposable"
        ],
        "sourceMap": true,
        "resolveJsonModule": true,
        "noImplicitAny": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "rootDir": ".",
        "types": [
            "jasmine",
            "node"
        ]
    }
}